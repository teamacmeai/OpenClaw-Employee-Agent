{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openclaw:contracts:eval-response:1.0",
  "title": "OpenClaw Evaluation Response",
  "description": "Output OpenClaw must return for one evaluation request. Return JSON only, with exactly these fields and no extra text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "work_blocks",
    "needs_review",
    "review_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Must equal the request_id of the request."
    },
    "work_blocks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/work_block"
      },
      "description": "Chronological work blocks inside the request window. Return an empty array when the window has fewer than 3 active minutes."
    },
    "needs_review": {
      "type": "boolean",
      "description": "true when evidence is too weak to classify confidently."
    },
    "review_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Required explanation when needs_review is true; otherwise null."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp that includes a UTC offset, e.g. 2026-11-20T09:00:00+06:00."
    },
    "work_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "category",
        "project",
        "summary",
        "active_minutes",
        "confidence",
        "files_referenced"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "category": {
          "enum": [
            "FEATURE_DEVELOPMENT",
            "DEBUGGING",
            "CODE_REVIEW",
            "DOCUMENTATION",
            "DESIGN",
            "MEETINGS_COMMUNICATION",
            "RESEARCH",
            "OTHER"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "description": "A project name that appears in the request, or null. Never invent one."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "One sentence describing the milestone or kind of work, not keystrokes. Use only facts present in the request."
        },
        "active_minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1440
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "files_referenced": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "Paths copied exactly from the request's file_events. Never invent paths."
        }
      }
    }
  }
}
